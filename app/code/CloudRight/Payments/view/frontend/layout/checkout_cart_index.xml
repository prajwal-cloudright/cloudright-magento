<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="CloudRight_Payments::css/cloudright-checkout.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="CloudRight\Payments\Block\Checkout"
                   name="cloudright.checkout.modal"
                   template="CloudRight_Payments::checkout.phtml"
                   after="-"/>
            <block class="CloudRight\Payments\Block\Checkout"
                   name="cloudright.checkout.script"
                   template="CloudRight_Payments::checkout-script.phtml"
                   after="cloudright.checkout.modal"/>
        </referenceContainer>
    </body>
</page>
